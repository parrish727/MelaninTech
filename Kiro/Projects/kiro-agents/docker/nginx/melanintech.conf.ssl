# nginx reverse proxy — corporate-grade security for melanin-tech.com
# Sits in front of the production-server container (localhost:3000)

# ── Rate limiting zones ───────────────────────────────────────────────────────
limit_req_zone $binary_remote_addr zone=general:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=contact:10m  rate=5r/m;
limit_conn_zone $binary_remote_addr zone=addr:10m;

# ── Redirect HTTP → HTTPS ─────────────────────────────────────────────────────
server {
    listen 80;
    server_name melanin-tech.com www.melanin-tech.com;

    # Allow Let's Encrypt ACME challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://www.melanin-tech.com$request_uri;
    }
}

# ── HTTPS — www canonical ─────────────────────────────────────────────────────
server {
    listen 443 ssl;
    http2 on;
    server_name www.melanin-tech.com;

    # TLS — managed by certbot
    ssl_certificate     /etc/letsencrypt/live/melanin-tech.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/melanin-tech.com/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/melanin-tech.com/chain.pem;

    # Modern TLS only
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;

    # HSTS — 1 year, include subdomains
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # ── Security headers ──────────────────────────────────────────────────────
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none';" always;

    # Hide server version
    server_tokens off;

    # ── Connection limits ─────────────────────────────────────────────────────
    limit_conn addr 20;
    client_max_body_size 2m;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 65s;
    send_timeout 10s;

    # ── Block common attack patterns ──────────────────────────────────────────
    location ~* \.(php|asp|aspx|jsp|cgi|sh|py|pl|env|git|htaccess|htpasswd|sql|bak|swp)$ {
        return 404;
    }
    location ~ /\. { return 404; }

    # ── Rate limit contact form endpoint ─────────────────────────────────────
    location /api/contact {
        limit_req zone=contact burst=3 nodelay;
        proxy_pass http://production-server:3000;
        include /etc/nginx/proxy_params;
    }

    # ── Static assets — long cache, no rate limit ─────────────────────────────
    location /_next/static/ {
        proxy_pass http://production-server:3000;
        proxy_cache_valid 200 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/proxy_params;
    }

    # ── Main proxy ────────────────────────────────────────────────────────────
    location / {
        limit_req zone=general burst=20 nodelay;
        proxy_pass http://production-server:3000;
        include /etc/nginx/proxy_params;
    }
}

# ── Redirect bare domain → www ────────────────────────────────────────────────
server {
    listen 443 ssl;
    http2 on;
    server_name melanin-tech.com;

    ssl_certificate     /etc/letsencrypt/live/melanin-tech.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/melanin-tech.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 301 https://www.melanin-tech.com$request_uri;
}
