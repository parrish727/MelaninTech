FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    "smolagents[litellm]==1.14.0" \
    fastapi==0.111.0 \
    uvicorn==0.29.0 \
    httpx==0.27.0 \
    psycopg2-binary==2.9.9 \
    python-dotenv==1.0.0

COPY agents/ ./agents/
COPY orchestrator/ ./orchestrator/
COPY config/ ./config/
COPY AI/ ./AI/

RUN useradd -r -u 1000 darius && chown -R darius:darius /app
USER darius

CMD ["python", "-m", "uvicorn", "AI.darius.server:app", "--host", "0.0.0.0", "--port", "8000"]
