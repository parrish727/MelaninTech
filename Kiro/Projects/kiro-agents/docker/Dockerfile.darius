FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    "smolagents[litellm]==1.14.0" \
    fastapi==0.111.0 \
    uvicorn==0.29.0 \
    httpx==0.27.0 \
    psycopg2-binary==2.9.9 \
    python-dotenv==1.0.0 \
    redis==5.0.0 \
    PyMuPDF==1.24.0 \
    python-docx==1.1.0 \
    PyYAML==6.0.1 \
    opentelemetry-api==1.27.0 \
    opentelemetry-sdk==1.27.0 \
    opentelemetry-exporter-otlp-proto-grpc==1.27.0 \
    opentelemetry-instrumentation-httpx==0.48b0

COPY agents/ ./agents/
COPY orchestrator/ ./orchestrator/
COPY config/ ./config/
COPY AI/ ./AI/
COPY integrations/ ./integrations/
COPY eval/ ./eval/
COPY scripts/ ./scripts/

RUN useradd -r -u 1000 darius && chown -R darius:darius /app
USER darius

CMD ["python", "-m", "uvicorn", "AI.darius.server:app", "--host", "0.0.0.0", "--port", "8000"]
