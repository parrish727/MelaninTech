{
  "compilerOptions": {
    "strict": true, "noImplicitAny": true, "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true, "resolveJsonModule": true,
    "isolatedModules": true, "jsx": "react-jsx", "target": "ES2022",
    "module": "ESNext", "moduleResolution": "bundler",
    "baseUrl": ".", "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
